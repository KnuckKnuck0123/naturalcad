# Frontend -> Domain API shared secret (optional for local dev)
NATURALCAD_ENV=development
API_SHARED_SECRET=

# Optional Modal worker endpoint and key
NATURALCAD_CAD_WORKER_URL=
NATURALCAD_CAD_WORKER_API_KEY=

# Supabase persistence (set both to enable DB-backed repository)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NATURALCAD_SOURCE_IMAGE_BUCKET=naturalcad-source-images

# Browser origins accepted when calling the API directly. Server-to-server BFF
# requests do not send Origin and authenticate with API_SHARED_SECRET.
NATURALCAD_ALLOWED_ORIGINS=http://localhost:3000

# Quotas
NATURALCAD_RATE_WINDOW_SECONDS=3600
NATURALCAD_GUEST_RUNS_PER_WINDOW=5
NATURALCAD_SIGNED_RUNS_PER_WINDOW=30
NATURALCAD_GUEST_PROJECT_GENERATION_CAP=0
NATURALCAD_GUEST_PROJECT_TOKEN_CAP=0

# OpenRouter model profiles (used by mode switcher metadata)
NATURALCAD_MODE_FAST=openai/gpt-4o-mini
NATURALCAD_MODE_BALANCED=google/gemini-2.5-pro
NATURALCAD_MODE_QUALITY=anthropic/claude-sonnet-4
NATURALCAD_VISION_MODEL=google/gemini-2.5-flash
NATURALCAD_CAD_MODEL=anthropic/claude-sonnet-4
NATURALCAD_VISION_SUMMARY_MAX_TOKENS=220
NATURALCAD_MAX_GUEST_ATTACHMENTS=3
