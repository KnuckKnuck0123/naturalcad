# Server-only. Never prefix either value with NEXT_PUBLIC_.
# These are read by apps/web/app/api/naturalcad/[...path]/route.ts.

# Where the backend domain API lives (no trailing slash).
# Local dev:   http://127.0.0.1:8010
# Beta:        https://api.beta.naturalcad.example
NATURALCAD_BACKEND_URL=http://127.0.0.1:8010

# Shared secret between Vercel and the backend (matches API_SHARED_SECRET on the backend).
# This is also forwarded to the Modal worker as x-api-key when proxied; the worker secret
# `naturalcad-api-key` should hold the same value.
NATURALCAD_API_KEY=
